# dependencies / build output
node_modules/
out/
dist/
*.tsbuildinfo

# logs & os cruft
*.log
.DS_Store

# secrets — never commit (.env holds a GitHub token used only for releasing)
.env
.env.*

# local Claude Code overrides (per-user)
.claude/settings.local.json

# local Mavis / MiniMax / OpenCode tool state (per-user)
.mavis/
.minimax/
.opencode/

# local agent / codex / doc-build state (per-user; not part of the app)
.agents/
.codex/
.doc-build/
docs/
devterm-commercial/

# local runtime terminal session state
terminals/

# onnxruntime-web wasm blobs copied from node_modules by scripts/setup-native.mjs
# (~32MB; regenerated on `npm run setup`, so not checked in)
src/renderer/public/ort/
