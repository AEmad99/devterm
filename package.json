{
  "name": "devterm",
  "version": "1.6.0",
  "description": "Windows desktop terminal for local shells and SSH, with tiling panes, SFTP, git, preview/annotate, and a built-in multi-provider coding agent. Remote hosts need nothing installed.",
  "main": "out/main/index.js",
  "author": "DevTerm",
  "license": "MIT",
  "scripts": {
    "setup": "node scripts/setup-native.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "electron-vite build && node scripts/ensure-pty-native.cjs && electron-builder --win --config electron-builder.yml --publish never",
    "build:linux": "electron-vite build && node scripts/ensure-pty-native.cjs && electron-builder --linux --config electron-builder.yml",
    "release:win": "electron-vite build && node scripts/ensure-pty-native.cjs && electron-builder --win --config electron-builder.yml --publish always",
    "release:linux": "electron-vite build && node scripts/ensure-pty-native.cjs && electron-builder --linux --config electron-builder.yml --publish always",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "tsx --tsconfig tsconfig.node.json --test \"src/**/*.test.ts\"",
    "test:grid": "node scripts/assert-grid.mjs",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.12",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-canvas": "^0.7.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.15",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.46.0",
    "marked": "^18.0.13",
    "node": "26.8.2",
    "node-pty": "npm:@homebridge/node-pty-prebuilt-multiarch@0.13.1",
    "ssh2": "^1.17.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^29.4.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  }
}
